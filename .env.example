# ============================================
# CosmosLens — Environment Variables
# ============================================
# Register for free API keys at:
#   NASA API: https://api.nasa.gov/
#   USGS: https://earthquake.usgs.gov/
#   ReliefWeb: https://apidoc.reliefweb.int/

# NASA API Keys (free — register at api.nasa.gov)
NASA_API_KEY_1=your_nasa_api_key_here
NASA_API_KEY_2=your_nasa_api_key_here
NASA_API_KEY_3=your_nasa_api_key_here
NASA_API_KEY_4=your_nasa_api_key_here
NASA_API_KEY_5=your_nasa_api_key_here
NASA_API_KEY_6=your_nasa_api_key_here
NASA_API_KEY_7=your_nasa_api_key_here

# NASA FIRMS (Wildfire Data)
FIRMS_MAP_KEY=your_firms_map_key_here

# USGS Earthquake API (no key required, but optional)
USGS_API_KEY=your_usgs_api_key_here

# UN ReliefWeb API (optional, for disaster context)
RELIEFWEB_API_KEY=your_reliefweb_api_key_here

# ============================================
# Database
# ============================================
POSTGRES_DB=cosmoslens
POSTGRES_USER=cosmoslens_user
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Backend (FastAPI)
# ============================================
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# ML Service
# ============================================
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_PORT=8001

# ============================================
# Frontend
# ============================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# Email Alerts (for region subscription system)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_FROM_EMAIL=cosmoslens@example.com
